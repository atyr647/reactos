; WDDM display driver host (DxgKrnl) - started on demand by display miniports
[AddReg]
HKLM,"SYSTEM\CurrentControlSet\Services\DXGKrnl","ErrorControl",0x00010001,0x00000001
HKLM,"SYSTEM\CurrentControlSet\Services\DXGKrnl","Group",0x00000000,"Base"
HKLM,"SYSTEM\CurrentControlSet\Services\DXGKrnl","ImagePath",0x00020000,"system32\drivers\dxgkrnl.sys"
HKLM,"SYSTEM\CurrentControlSet\Services\DXGKrnl","Start",0x00010001,0x00000003
HKLM,"SYSTEM\CurrentControlSet\Services\DXGKrnl","Type",0x00010001,0x00000001
