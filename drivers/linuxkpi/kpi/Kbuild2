# Out-of-tree Linux module: LinuxKPI part 2 (dma-fence, dma-resv, workqueue, device model...). See build2.sh.
obj-m += kpi2.o
kpi2-y := kpi2_core.o kpi2_dev.o kpi2_mm.o $(patsubst %.c,%.o,$(notdir $(KPI2_SRCS)))
ccflags-y := -I$(srctree)/drivers/dma-buf -I$(srctree)/lib -Wno-unused-function -Wno-error
